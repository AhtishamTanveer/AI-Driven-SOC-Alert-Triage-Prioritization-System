# Copy this file to ".env" and fill in your real values.
# NEVER upload your real .env to GitHub.

# ---- Wazuh Indexer (used by wazuh_integration.py and wazuh_indexer.py) ----
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_USER=admin
WAZUH_PASSWORD=your_password_here

# Name of the Wazuh agent to read alerts for
WAZUH_AGENT_NAME=Windows-PC

# How far back to read alerts (examples: now-30m, now-12h, now-2d)
WAZUH_LOOKBACK=now-2d

# Max alerts fetched per request (1-1000) and request timeout in seconds
WAZUH_FETCH_SIZE=500
WAZUH_TIMEOUT=15

# ---- Wazuh Manager API (used only by wazuh_test.py) ----
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=your_api_password_here

# ---- TLS options (choose ONE) ----
# 1) Best: trust the Wazuh root CA file
# WAZUH_CA_CERT=C:\path\to\root-ca.pem
# 2) Local lab only (self-signed cert, no verification):
WAZUH_VERIFY_SSL=false
